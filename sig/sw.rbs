module Sw
  VERSION: String

  API_URL: String

  class Model < Data
    attr_reader characters: Characters::Model?
    attr_reader failure: String?
    attr_reader loading: bool
    attr_reader focus: Symbol
    def initialize: (characters: Characters::Model?, ?failure: String?, ?loading: bool, ?focus: Symbol) -> void
    def with: (?characters: Characters::Model?, ?failure: String?, ?loading: bool, ?focus: Symbol) -> Model
    def loading?: () -> bool
  end

  Download: ^() -> Load
  Init: ^() -> [Model, Load]
  View: ^(Model, RatatuiRuby::TUI) -> RatatuiRuby::Layout::Layout
  Update: ^(Rooibos::message, Model) -> [Model, Rooibos::Command::execution?]

  class Character < Data
    attr_reader name: String
    attr_reader vehicles: Collection[Vehicle]
    def initialize: (name: String, ?vehicles: Collection[Vehicle]) -> void
  end

  class Count < Data
    attr_reader text: String
    def initialize: (String text) -> void
                  | (text: String) -> void
    def to_s: () -> String
  end

  class Vehicle < Data
    attr_reader name: String
    attr_reader model: String
    attr_reader manufacturer: String
    attr_reader vehicle_class: String
    attr_reader crew: Count
    attr_reader passengers: Count
    def initialize: (name: String, model: String, manufacturer: String, vehicle_class: String, crew: Count, passengers: Count) -> void
  end

  class Collection[T] < Data
    include Enumerable[T]
    def initialize: (Array[T] records) -> void
    def each: () { (T) -> void } -> Array[T]
            | () -> Enumerator[T, Array[T]]

    private

    attr_reader records: Array[T]
  end

  class Load < Data
    include Rooibos::Command::Custom
    Command: singleton(Rooibos::Command)
    attr_reader url: String
    def initialize: (url: String) -> void
    def call: (Rooibos::Command::Outlet out, Concurrent::Cancellation token) -> void

    class Finished < Data
      include Rooibos::Message::Predicates
      attr_reader characters: Collection[Character]
      attr_reader vehicles: Collection[Vehicle]
      def initialize: (characters: Collection[Character], vehicles: Collection[Vehicle]) -> void
    end

    class Failed < Data
      include Rooibos::Message::Predicates
      attr_reader reason: String
      def initialize: (reason: String) -> void
    end

    class Mapper
      COLLECTIONS: Hash[Symbol, [Symbol, singleton(Character) | singleton(Vehicle)]]
      FIELDS: Hash[Symbol, singleton(Count)]
      def links: (String root) -> Hash[Symbol, String]
      def parse: (String body) -> Array[Hash[String, untyped]]
      def records: (**Array[Hash[String, untyped]]) -> Hash[Symbol, Collection[Character | Vehicle]]
    end
  end

  module Characters
    class Model < Data
      attr_reader collection: Collection[Character]
      attr_reader selected: Character?
      def initialize: (collection: Collection[Character], selected: Character?) -> void
      def with: (?collection: Collection[Character], ?selected: Character?) -> Model
    end

    Init: ^(characters: Collection[Character]) -> Model
    Select: ^(Symbol, Model) -> Model
    Update: ^(Rooibos::message, Model) -> [Model, Rooibos::Command::execution?]
    View: ^(Model, RatatuiRuby::TUI, ?focused: bool) -> RatatuiRuby::Widgets::List
  end

  module Vehicles
    View: ^(Collection[Vehicle], RatatuiRuby::TUI) -> RatatuiRuby::Widgets::Paragraph
  end
end
