module Sw
  VERSION: String

  API_URL: String

  class Model < Data
    attr_reader characters: Characters::Model?
    attr_reader films: Collection[Film]?
    attr_reader failure: String?
    attr_reader loading: bool
    attr_reader focus: Symbol
    attr_reader search: Search::Model
    def initialize: (characters: Characters::Model?, films: Collection[Film]?, ?failure: String?, ?loading: bool, ?focus: Symbol, ?search: Search::Model) -> void
    def with: (?characters: Characters::Model?, ?films: Collection[Film]?, ?failure: String?, ?loading: bool, ?focus: Symbol, ?search: Search::Model) -> Model
    def loading?: () -> bool
  end

  FocusOrder: Array[Symbol]
  ListWidth: Integer
  TITLE: String
  Header: ^(RatatuiRuby::TUI, RatatuiRuby::Widgets::Paragraph, ?RatatuiRuby::Widgets::Paragraph?) -> RatatuiRuby::Layout::Layout
  FocusStep: ^(Model, Integer) -> Model
  Searching: ^(Rooibos::message, Model) -> bool
  Download: ^() -> Load
  Init: ^() -> [Model, Load]
  View: ^(Model, RatatuiRuby::TUI) -> RatatuiRuby::Layout::Layout
  Update: ^(Rooibos::message, Model) -> [Model, Rooibos::Command::execution?]

  class Character < Data
    attr_reader name: Value
    attr_reader vehicles: Collection[Vehicle]
    attr_reader starships: Collection[Starship]
    attr_reader films: Collection[Film]
    def initialize: (name: Value, ?vehicles: Collection[Vehicle], ?starships: Collection[Starship], ?films: Collection[Film]) -> void
  end

  class Film < Data
    attr_reader title: Value
    attr_reader episode_id: RomanNumeral
    attr_reader characters: Collection[Character]
    def initialize: (title: Value, episode_id: RomanNumeral, ?characters: Collection[Character]) -> void
    def episode: () -> String
  end

  class Value < Data
    include Comparable
    attr_reader text: String
    def initialize: (String text) -> void
                  | (text: String) -> void
    def to_s: () -> String
    def unknown?: () -> bool
    def <=>: (untyped other) -> Integer?
  end

  class Vehicle < Data
    attr_reader name: Value
    attr_reader model: Value
    attr_reader manufacturer: Value
    attr_reader vehicle_class: Value
    attr_reader crew: Value
    attr_reader passengers: Value
    attr_reader pilots: Collection[Character]
    def initialize: (name: Value, model: Value, manufacturer: Value, vehicle_class: Value, crew: Value, passengers: Value, ?pilots: Collection[Character]) -> void
  end

class Starship < Data
  attr_reader name: Value
  attr_reader model: Value
  attr_reader manufacturer: Value
  attr_reader starship_class: Value
  attr_reader crew: Value
  attr_reader passengers: Value
  attr_reader pilots: Collection[Character]
  def initialize: (name: Value, model: Value, manufacturer: Value, starship_class: Value, crew: Value, passengers: Value, ?pilots: Collection[Character]) -> void
end

class Collection[T] < Data
    include Enumerable[T]
    def initialize: (Array[T] items) -> void
    def each: () { (T) -> void } -> Array[T]
            | () -> Enumerator[T, Array[T]]

    private

    attr_reader items: Array[T]
  end

  class Load < Data
    include Rooibos::Command::Custom
    Command: singleton(Rooibos::Command)
    attr_reader url: String
    def initialize: (url: String) -> void
    def call: (Rooibos::Command::Outlet out, Concurrent::Cancellation token) -> void

    class Finished < Data
      include Rooibos::Message::Predicates
      attr_reader characters: Collection[Character]
      attr_reader vehicles: Collection[Vehicle]
      attr_reader starships: Collection[Starship]
      attr_reader films: Collection[Film]
      def initialize: (characters: Collection[Character], vehicles: Collection[Vehicle], starships: Collection[Starship], films: Collection[Film]) -> void
    end

    class Failed < Data
      include Rooibos::Message::Predicates
      attr_reader reason: String
      def initialize: (reason: String) -> void
    end

    class Mapper
      COLLECTIONS: Hash[Symbol, [Symbol, singleton(Character) | singleton(Vehicle) | singleton(Starship) | singleton(Film)]]
      NUMERALS: Array[Symbol]
      def links: (String root) -> Hash[Symbol, String]
      def parse: (String body) -> Array[Hash[String, untyped]]
      def records: (**Array[Hash[String, untyped]]) -> Hash[Symbol, Collection[Character | Vehicle | Starship | Film]]
    end
  end

  module Characters
    class Model < Data
      attr_reader collection: Collection[Character]
      attr_reader selected: Character?
      attr_reader query: String
      def initialize: (collection: Collection[Character], selected: Character?, ?query: String) -> void
      def with: (?collection: Collection[Character], ?selected: Character?, ?query: String) -> Model
      def matches: () -> Collection[Character]
    end

    Init: ^(characters: Collection[Character], ?query: String) -> Model
    Select: ^(Symbol, Model) -> Model
    Update: ^(Rooibos::message, Model) -> [Model, Rooibos::Command::execution?]
    EMPTY: String
    Empty: ^(String, RatatuiRuby::TUI) -> RatatuiRuby::Widgets::Paragraph
    View: ^(Model, RatatuiRuby::TUI, number: Integer, ?focused: bool) -> (RatatuiRuby::Widgets::List | RatatuiRuby::Widgets::Block)
  end

  module Search
    class Model < Data
      attr_reader query: String
      def initialize: (query: String) -> void
      def with: (?query: String) -> Model
    end

    class QueryChanged < Data
      include Rooibos::Message::Predicates
      attr_reader query: String
      def initialize: (query: String) -> void
    end

    Init: ^() -> Model
    ClearKey: [String, String]
    Keys: Array[[String, String]]
    Typed: ^(Rooibos::message, Model) -> bool
    View: ^(Model, RatatuiRuby::TUI, focused: bool, number: Integer) -> RatatuiRuby::Widgets::Paragraph
    Update: ^(Rooibos::message, Model) -> [Model, Rooibos::Command::execution?]
  end

  module SelectedCharacter
    View: ^(Character?, RatatuiRuby::TUI) -> RatatuiRuby::Widgets::Block
  end

  module Films
    Column: ^(Film, bool, RatatuiRuby::TUI) -> RatatuiRuby::Widgets::Paragraph
    View: ^(Collection[Film], Collection[Film]?, RatatuiRuby::TUI) -> RatatuiRuby::Widgets::Block
  end

  module Starships
    EMPTY: String
    Starship: ^(Sw::Starship, RatatuiRuby::TUI, first: bool) -> RatatuiRuby::Widgets::Table
    Stack: ^(Collection[Sw::Starship], RatatuiRuby::TUI) -> RatatuiRuby::Layout::Layout
    Empty: ^(RatatuiRuby::TUI) -> RatatuiRuby::Layout::Layout
    View: ^(Collection[Sw::Starship]?, RatatuiRuby::TUI) -> RatatuiRuby::Widgets::Block
  end

  module Values
    Span: ^(Value, RatatuiRuby::TUI) -> RatatuiRuby::Text::Span
    Pair: ^(Value, Value, RatatuiRuby::TUI) -> RatatuiRuby::Text::Line
  end

  module Vehicles
    EMPTY: String
    Vehicle: ^(Sw::Vehicle, RatatuiRuby::TUI, first: bool) -> RatatuiRuby::Widgets::Table
    Stack: ^(Collection[Sw::Vehicle], RatatuiRuby::TUI) -> RatatuiRuby::Layout::Layout
    Empty: ^(RatatuiRuby::TUI) -> RatatuiRuby::Layout::Layout
    View: ^(Collection[Sw::Vehicle]?, RatatuiRuby::TUI) -> RatatuiRuby::Widgets::Block
  end
end

# From the roman gem, which ships no signatures. Only what the app uses.
class RomanNumeral < Numeric
  include Comparable
  def initialize: (Integer | String value) -> void
  def to_s: () -> String
  def to_i: () -> Integer
end
